out/
release/

# Runtime layout: keep source-controlled bioinformatics tools, ignore generated/bundled JDK and JavaFX SDKs
runtime/**/jdk*/
runtime/**/jre*/
runtime/**/javafx-sdk*/
!runtime/
!runtime/common/
!runtime/common/bbmap/
!runtime/linux/
!runtime/linux/blast/
!runtime/windows/
!runtime/windows/blast/

